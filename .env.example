# ==========================================================================
# BE-COMIC — cấu hình local development
# ==========================================================================
# Copy this file to `.env` and fill real secrets before running. Example:
# cp .env.example .env
# Then edit `.env` and DO NOT commit it.

# HTTP server (3000 — default 8000 đụng cổng health của image-ai)
PORT=3000

# CORS: các origin FE được phép gọi, cách nhau dấu phẩy.
# Deploy thêm domain thật: http://localhost:4200,https://comic.example.com
CORS_ORIGINS=http://localhost:4200

# Database Postgres (container be-comic-postgres)
# If you use Docker Compose, service name is usually `be-comic-postgres`.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=admin_password
DB_DATABASE=comic_db

# JWT auth (bắt buộc khi NODE_ENV=production)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_secret
EXPIRESIN_LOGIN=1h
EXPIRESIN_REFRESH_LOGIN=7d

# gRPC orchestrator-ai (50054 — KHÔNG phải 50052, đó là story-ai)
# Default target: localhost:50054 (match orchestrator-ai/.env.example)
ORCHESTRATOR_URL=localhost:50054

# If image uploads are stored in MinIO, ensure the MinIO settings below match image-ai


# MinIO (kho ảnh — cùng container với image-ai)
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PRESIGN_EXPIRY_SEC=3600